function np-cb-snmp-system-scan() {
  local snmp=$1 ; shift
  local target=$1 ; shift
  local boid=.1.3.6.1.2.1.1

  local sysDescr sysObjectID sysContact sysName sysLocation

  while read-oid-equal-value ; do
    case $OID in
      $boid.1.0) sysDescr=${VALUE//[^$'\x20'-$'\x79']/.} ;;
      $boid.2.0) sysObjectID=$VALUE ;;
      $boid.3.0) sysUptime=$TIMETICKS ;;
      $boid.4.0) sysContact=$VALUE ;;
      $boid.5.0) sysName=$VALUE ;;
      $boid.6.0) sysLocation=$VALUE ;;
    esac
  done

  echo "$target sys-type $sysDescr"
  echo "$target sys-name $sysName"
  [[ $sysLocation ]] && echo "$target sys-location $sysLocation"
  [[ $sysContact ]] && echo "$target sys-contact $sysContact"
  [[ $sysUptime ]] && echo "$target sys-uptime $sysUptime"

  return 0
}


