}

function np-x-snmp-if() {
  local snmp=$1 ; shift
  local target=$1 ; shift
  local boid=.1.3.6.1.2.1.2.2.1
  local ifgreatestlastchange=0

  declare -A ifname ifmac iflastchange ifadminstatus ifoperstatus

  while read-oid-equal-value ; do
    case $OID in
      $boid.2.*) ifname[${OID#$boid.2.}]=$VALUE ;;
      $boid.6.*) ifmac[${OID#$boid.6.}]=$ETHER ;;
      $boid.7.*) {
        to-string $VALUE undefined up down
        ifadminstatus[${OID#$boid.7.*}]=$REPLY
      } ;;
      $boid.8.*) {
        to-string $VALUE undefined up down
        ifoperstatus[${OID#$boid.8.*}]=$REPLY
      } ;;
      $boid.9.*) {
        (( TIMETICKS/100 > ifgreatestlastchange )) && ifgreatestlastchange=$((TIMETICKS/100))
        iflastchange[${OID#$boid.9.}]=$((TIMETICKS/100))
      } ;;
    esac
  done
  for idx in ${!ifmac[@]} ; do
    echo -n "$target ifname #$idx ${ifname[$idx]:--}"
    echo -n " ${ifmac[$idx]:--}"
    echo -n " ${ifadminstatus[$idx]:--}/${ifoperstatus[$idx]}"
    # if (((ifgreatestlastchange-${iflastchange[$idx]:--}) >= 60*86400)); then 
    #   echo -n " $(((ifgreatestlastchange-${iflastchange[$idx]:--})/(30*86400))) months ago"
    # elif (((ifgreatestlastchange-${iflastchange[$idx]:--}) >= 14*86400)); then 
    #   echo -n " $(((ifgreatestlastchange-${iflastchange[$idx]:--})/(7*86400))) weeks ago"
    # elif (((ifgreatestlastchange-${iflastchange[$idx]:--}) >= 2*86400)); then 
    #   echo -n " $(((ifgreatestlastchange-${iflastchange[$idx]:--})/(1*86400))) days ago"
    # elif (((ifgreatestlastchange-${iflastchange[$idx]:--}) >= 2*3600)); then 
    #   echo -n " $(((ifgreatestlastchange-${iflastchange[$idx]:--})/(1*3600))) hours ago"
    # else
    #   echo -n " $((ifgreatestlastchange-${iflastchange[$idx]:--})) seconds ago"
    # fi
    echo -n " $(((ifgreatestlastchange-${iflastchange[$idx]:--})/86400)) days ago"
    echo
    
  done
  return 0
}

