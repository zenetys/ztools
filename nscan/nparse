function auto-create-fixed-columns-parser() {
  awk -v FS='' '
  {
    if (NR == 1) h = $0;
    for (i = 1 ; i < NF ; i++) {
      if (NR == 1)
        a[i]=" ";
      else if ($i != " ")
        delete a[i];
    }
    a[i+1] = " ";
  }
  END {
    printf("function fixed-columns-parser(){\n");
    printf(" local a=()\n");
    printf(" local IFS=$\"\t\"\n");
    printf(" while read; do\n");
    printf("  a=(\n");
    i = 1;
    for (j in a) b[i++] = j;
    j = 0;
    for (i = 1 ; b[i] ; i++) {
      # merge field with empty header
      if (match(substr(h, b[i], b[i+1]-b[i]), "^ +$")) continue;
      printf("   \"${REPLY:%d:%d}\"\n", j, b[i]-j-1);
      j = b[i];
    }
    printf("  )\n");
    printf("  a=( \"${a[@]##*( )}\" )\n");
    printf("  echo \"${a[*]%%%%*( )}\"\n");
    printf(" done\n");
    printf("}\n");
  }
  '
}

function gettsv2something() {
  local IFS=$'\t'
  local headers
  read LINE
  headers=( $LINE )
  read LINE || return 1
  while [[ "${LINE:0:1}" != "-" ]]; do
    local headers_next=( $LINE )
    for ((i = 0 ; i < ${#headers[@]} ; i++)); do
      headers[i]="${headers[i]}${headers_next[i]}"
    done
    read LINE || return 1
  done
  while read LINE; do
    cols=( $LINE )
    for ((i = 0 ; i < ${#headers[@]} ; i++)); do
      echo "$origin k[${command%% *}].k[${cols[0]}].${headers[i]}=${cols[i]}"
    done
  done
}

function np-winexe-getarray() {
  local command=$1
  local IFS=$'\t'
  local lines=( )

  read LINE ; while [[ ${#LINE} -le 1 ]]; do read LINE; done
  while [[ $? == 0 ]] && [[ ${#LINE} -gt 1 ]] ; do
    LINE=${LINE%$'\r'}
    lines+=( "$LINE" )
    read LINE
  done
  output="$(IFS=$'\n';echo "${lines[*]}"|iconv -f UTF8 -t ISO8859-1//TRANSLIT)"
  eval "$(auto-create-fixed-columns-parser <<< "${output}")"
  fixed-columns-parser <<<"${output}" |
    gettsv2something
}

function np-winexe() {
  local IFS=' '
  local command=( $1 ); shift
  if [[ ${command[0]} == "hostname" ]]; then
    np-winexe-getline && origin=${REPLY%$'\r'}
  elif [[ ${command[0]} == "systeminfo" ]]; then
    np-winexe-getlist ${command[0]}
  elif [[ ${command[0]:0:4} == "gwmi" ]]; then
    np-winexe-getlist ${command[3]}
  elif [[ ${command[0]:0:13} == "Get-GPOReport" ]]; then
    np-winexe-xml ${command[0]}
  elif [[ ${command[0]:0:4} == "Get-WmiObject" ]]; then
    np-winexe-getarray ${command[2]}
  elif [[ ${command[0]:0:4} == "Get-" ]]; then
    np-winexe-getarray ${command[0]}
  else
    np-winexe-getblock ${command[0]}
  fi
}

