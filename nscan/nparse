function np-iproute2-ip-address() {
  local source=$1 ; shift
  local origin=$1 ; shift
  local IFS=$'\r '
  local PATTERN2="([0-9]+): ([0-9a-zA-Z_@.]+): <([^>]*)> (.*)"
  local ether ipv4 ifid ifname ifstate

  while read ; do
    if [[ ${REPLY} =~ $PATTERN2 ]] ; then
      ifid=${BASH_REMATCH[1]}
      ifname=${BASH_REMATCH[2]}
      ifstate=${BASH_REMATCH[3]}
      set -- ${BASH_REMATCH[4]}
    else
      set -- $REPLY
    fi

    [[ $# -gt 2 ]] || break

    while (( $# > 0 )) ; do
      case $1 in
        mtu) shift ;;
        qdisc) shift ;;
        state) shift ;;
        group) shift ;;
        qlen) shift ;;
        valid_lft) shift ;;
        preferred_lft) shift ;;
        link/ipip) shift ;;
        link/loopback) shift ;;
        link/ether) ether=$2 ; shift ;;
        inet) ipv4=$2 ; shift ;;
        inet6) shift ;;
        brd) shift ;;
        scope) shift ; shift ;;
        *) warning "ip-address unknown option '$1'" ;;
      esac
      shift
    done

    [[ $ether ]] && {
      echo "$source:$origin ether $ether $ifname"
      unset ether
    }
    [[ $inet ]] && {
      echo "$source:$origin ipv4 $ipv4 $ifname"
      unset ipv4
    }
  done
}

function np-iproute2-ip-route() {
  local source=$1 ; shift
  local origin=$1 ; shift
  local IFS=$'\r '
  local gw ifname net

  while read ; do
    set -- ${REPLY}
    net=$1 ; shift
    [[ $# -gt 2 ]] || break
    while (( $# > 0 )) ; do
      case $1 in
        via) gw=$2 ; shift ;;
        dev) ifname=$2 ; shift ;;
        proto) shift ;;
        src) shift ;;
        scope) shift ;;
        *) warning "ip-route unknown option <$1>" ;;
      esac
      shift
    done
    echo "$source:$origin route $net $gw $ifname"
  done
}

function np-iproute2-ip-neigh() {
  local source=$1 ; shift
  local origin=$1 ; shift
  local IFS=$'\r '
  local addr ether ifname

  while read ; do
    unset ether addr ifname
    set -- ${REPLY}
    addr=$1 ; shift
    [[ $# -gt 2 ]] || break
    while (( $# > 0 )) ; do
      case $1 in
        dev) ifname=$2 ; shift ;;
        lladdr) ether=$2 ; shift ;;
        STALE) shift ;;
        FAILED) shift ;;
        REACHABLE) shift ;;
        DELAY) shift ;;
        *) warning "ip-neigh unknown option <$1>" ;;
      esac
      shift
    done
    [[ $ether ]] && echo "$source:$origin arp $ether $addr $ifname"
  done
}

function np-iproute2() {
  local IFS=' '
  while read ; do
    if [[ $REPLY =~ "ip a" ]] ; then
      np-iproute2-ip-address "$@"
    elif [[ $REPLY =~ "ip ro" ]] ; then
      np-iproute2-ip-route "$@"
    elif [[ $REPLY =~ "ip n" ]] ; then
      np-iproute2-ip-neigh "$@"
    fi
  done
}

function np-winexe-getline() {
  local command=$1
  read REPLY
  [[ $command == hostname ]] && origin=$REPLY 
  echo "$origin $command $origin"
  return 0
}

function np-winexe-getblock() {
  local command=$1
  local block
  
  while read LINE; do
    if [[ ${LINE:0:4} == "==> " ]]; then
      echo "$origin block[${command%% *}] ${block%\\n}"
      NP_WINEXE_CONTINUE=1
      return 0
    fi
    block="$block${LINE%$'\r'}\\n"
  done
  echo "$origin block[${command%% *}] ${block%\\n}"
  return 0
}

function np-winexe-xml() {
  local command=$1
  while read LINE; do
    if [[ ${LINE:0:4} == "==> " ]]; then
      NP_WINEXE_CONTINUE=1
      return 0
    fi
  done
  return 0
}

function np-winexe-getlist() {
  local command=$1
  local IFS=$'\t'
  local key skey spcs attr
  read LINE ; while [[ ${LINE%$'\r'} == "" ]]; do read LINE; done
  while [[ $? == 0 ]] ; do
    LINE=${LINE%$'\r'}
    if [[ ${LINE} == "" ]]; then
      break
    elif [[ ${LINE} =~ ^([^ ][^:]*)\ *:\ +(.*)$ ]]; then
      # Attribut: Value
      spcs=0
      key[spcs]="k[$command].k[${BASH_REMATCH[1]%%*( )}]"
      echo "$origin ${key[spcs]}._value ${BASH_REMATCH[2]}"
    elif [[ ${LINE} =~ ^([\ ]+)\[([0-9]+)\][^:]*:\ +(.*)$ ]]; then
      # <space>[xx]: Value
      (( ${#BASH_REMATCH[1]}+1 <= spcs )) && key[spcs]=${key[${#BASH_REMATCH[1]}+1]%.k\[*}
      key[${#BASH_REMATCH[1]}+1]="${key[spcs]}.k[${BASH_REMATCH[3]%%*( )}]"
      ((spcs=${#BASH_REMATCH[1]}+1))
      echo "$origin ${key[spcs]}._id ${BASH_REMATCH[2]}"
    elif [[ ${LINE} =~ ^([\ ]+)([^:]*)\ *:\ +([^:]*)$ ]] ; then
      # <space>Attribut: Value
      (( ${#BASH_REMATCH[1]} <= spcs )) && key[spcs]=${key[${#BASH_REMATCH[1]}]%.k\[*}
      key[${#BASH_REMATCH[1]}]="${key[spcs]}.k[${BASH_REMATCH[2]%%*( )}]"
      spcs=${#BASH_REMATCH[1]}
      echo "$origin ${key[spcs]}._value = ${BASH_REMATCH[3]}"
    elif [[ ${LINE} =~ ^([\ ]+)([^:]*)$ ]] ; then
      # <space>Attribut (start of array)
      (( ${#BASH_REMATCH[1]} <= spcs )) && key[spcs]=${key[${#BASH_REMATCH[1]}]%.k\[*}
      key[${#BASH_REMATCH[1]}]="${key[spcs]}.k[${BASH_REMATCH[2]%%*( )}]"
      spcs=${#BASH_REMATCH[1]}
    fi
    read LINE
  done
}

