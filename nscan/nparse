function to-string() {
  local value=$1; shift
  local values=( "$@" )
  if (( $value < ${#values[@]} )); then
    REPLY="${values[$value]}"
  else
    REPLY="undefined"
  fi
}

function np-cb-snmp-ifTable-scan() {
