}

function nparse-generic() {
  local PATTERN1="<<<< ([^\ ]+)\ ?(.*) >>>>"
  local PATTERN2="^==> ([^:]+) :"
  local LINE
  # read first line
  read LINE
  # while read in loop
  while [[ $? == 0 ]] ; do
    if [[ $LINE =~ $PATTERN1 ]] ; then
      debug -7 "Found header '$LINE'"
      if declare -F np-${BASH_REMATCH[1]} >/dev/null ; then
        debug -5 "Parse ${BASH_REMATCH[2]} with np-${BASH_REMATCH[1]}"
        np-${BASH_REMATCH[1]} ${BASH_REMATCH[2]}
      else
        debug -3 "Parse ${BASH_REMATCH[2]} : undefine parser ${BASH_REMATCH[1]}"
      fi
    elif [[ $LINE =~ $PATTERN2 ]] ; then
      debug -7 "Found header '$LINE'"
      np-winexe "${BASH_REMATCH[1]%$'\r'}"
      (( $NP_WINEXE_CONTINUE )) && {
        NP_WINEXE_CONTINUE=0
        continue
      }
    fi
    # read new line
    read LINE
  done
  return 0
}

function my_cat() {
  if [[ -z ${1##*.gz} ]] ; then
    zcat "$1"
  elif [[ -z ${1##*.xz} ]] ; then
    xzcat "$1"
  else
    cat "$1"
  fi
}

function version() {
  while read COMMENT ATTRIBUT VALUE; do
    [[ "${COMMENT:0:1}" == "#" ]] || break
    case "$ATTRIBUT" in
      "Program:")   PROGRAM=$VALUE ;;
      "Version:")   VERSION=$VALUE ;;
      "License:")   LICENSE=$VALUE ;;
      "Author:")    AUTHOR=$VALUE ;;
      "Copyright:") COPYRIGHT=$VALUE ;;
    esac
  done < $0
  echo "${0##*/} $VERSION - Copyright $COPYRIGHT, $AUTHOR"
  echo "License $LICENSE"
}

function usage() {
  local IFS=$'\t'
  if [[ $0 == "-bash" ]] ; then return 1 ; fi
  [[ $# -gt 0 ]] && echo "ERROR: $*" >&2
  version >&2
  echo "Usage: ${0##*/} [options] HOST ..." >&2
  echo "Options:" >&2
  sed -nr "s/^[[:space:]]*## ([^:]*): /\1\t/p" -- "$0" |
    while read OPT DESC ; do
      printf " %-20s %s\n" "$OPT" "$DESC" >&2
    done
  return 0
}

function debug() {
  if [[ ${1:0:1} == "-" ]] ; then
    (( ${1:1} > VERBOSE )) && return
    shift
  fi
  echo "[DEBUG] $* (${FUNCNAME[1]}:${BASH_SOURCE[1]##*/}:${BASH_LINENO[0]})" >&2

}

function warning() {
  echo "WARNING: $*" >&2
}

function fatal() {
  echo "FATAL: $*" >&2
  exit 1
}

function onEXIT() {
  local EXITCODE=$?
  return $EXITCODE
}

declare QUIET=${QUIET:-1}
declare VERBOSE=${VERBOSE:-0}

while (( $# > 0 )); do
  case "$1" in
    ## -h, --help: This help
    -h|--help) usage && exit 0 ;;
    ## -V, --version: Show version
    -V|--version) version && exit 0 ;;
    ## --x-debug: Enable bash debug mode
    --x-debug)    XDEBUG=1 ;;
    ## -v, --verbose: increase verbose level
    -v|--verbose) ((VERBOSE++)) ;;
    --) shift ; break ;;
    -*) usage "Unknown parameter '$1'" && exit 1 ;;
    *) ARGS+=( "$1" ) ;;
  esac
  shift
done

[[ $XDEBUG == 1 ]] && set -x
(( $VERBOSE < 3 )) && function debug() { return $? ; }

# Make VERBOSE&QUIET inverted variables
(( VERBOSE == 0 )) && { QUIET=1 ; unset VERBOSE ; } || unset QUIET

trap onEXIT EXIT

[[ ${#ARGS[@]} == 0 ]] && ARGS=( /dev/stdin )

for input in "${ARGS[@]}" ; do
  if [[ ${input:0:1} == ":" ]] ; then
    # input form is ':parser:filename'
    IFS=":" read empty nparser input <<<"$input"
    my_cat "$input" | np-$nparser file $input
  else
    my_cat "$input" | nparse-generic
  fi
done
