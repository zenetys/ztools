function read-oid-equal-value() {
  local IFS=$' '

  unset VALUE ETHER IPADDR TIMETICKS
  read OID EQUAL ORIGIN || return $?
  # [[ -z $OID ]] && { echo $OID $EQUAL $ORIGIN ; return 255 ; }
  [[ $OID ]] || return 255
  debug -9 "read-oid-equal: $OID = $ORIGIN"
  if [[ ${ORIGIN:0:12} == "Hex-STRING: " ]] ; then
    VALUE="${ORIGIN:11}"
    [[ ${#VALUE} == 12 ]] && { 
      printf -v IPADDR "%d.%d.%d.%d" ${VALUE// / 0x}
    }
    [[ ${#VALUE} == 18 ]] && { 
      ETHER=${VALUE:1} ; ETHER=${ETHER// /:} ; ETHER=${ETHER,,} ;
    }
    printf -v VALUE "${VALUE// /\\x}"
  elif [[ ${ORIGIN:0:9} == "INTEGER: " ]] ; then
    VALUE=${ORIGIN:9}
  elif [[ ${ORIGIN:0:11} == "IpAddress: " ]] ; then
    VALUE=${ORIGIN:11}
  elif [[ ${ORIGIN:0:5} == "OID: " ]] ; then
    VALUE=${ORIGIN:5}
  elif [[ ${ORIGIN} == '""' ]] ; then
    VALUE=""
  elif [[ ${ORIGIN:0:10} == "Timeticks:" ]]; then
    VALUE="${ORIGIN:11}"
    TIMETICKS="${VALUE%%)*}"
    TIMETICKS="${TIMETICKS:1}"
  else
    VALUE="$ORIGIN"
  fi
  return 0
}

function np-cb-snmp-dot1qTpFdbTable-scan() {
  local snmp=$1 ; shift
  local target=$1 ; shift
  local boid=.1.3.6.1.2.1.17.7.1.2.2.1
  local pidx
  local ether
  local vlan

  while read-oid-equal-value ; do
    case $OID in
      $boid.2.*) {
        vlan=${OID#$boid.2.}; vlan=${vlan%%.*}
        ether=${OID#$boid.2.}; ether=${ether#*.}
        printf -v ether "%02x:%02x:%02x:%02x:%02x:%02x" ${ether//./ }
        pidx=$VALUE
        echo "$target dot1qFdb $ether p$pidx ($vlan)"
      } ;;
    esac
  done
  return 0
}

